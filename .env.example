# Copy to .env (gitignored) and edit. `pulse.sh` auto-sources .env.

# Directory tree of YYYY/MM/DD/*.md notes (e.g. an Obsidian vault that
# stores exported LLM chats). Required.
PI_PULSE_NOTES_DIR="$HOME/notes/chats"

# Where to drop the daily brief in addition to ./out/. Optional. If
# unset, the brief is only written to ./out/YYYY-MM-DD.md.
PI_PULSE_DELIVERY="$HOME/notes/Pulse"

# Path to the anki_search.py script from the anki-search skill.
# Optional; if unset, the collector looks at the default location
# ~/.claude/skills/anki-search/anki_search.py and on $PATH.
# PI_PULSE_ANKI_SEARCH="$HOME/.claude/skills/anki-search/anki_search.py"

# Brave Search API key. REQUIRED for the expand stage -- prompts/
# compose_expand.md tells the model to use the brave-search skill
# (size-bounded markdown) instead of pi's built-in web_search (whose
# results have overflowed the 262k context window). Get a free "Free
# AI" subscription at https://api-dashboard.search.brave.com/register
# and paste the key here.
#
# IMPORTANT for launchd / cron: env vars from ~/.zprofile, ~/.profile,
# or ~/.zshrc are NOT inherited by launchd jobs. Setting BRAVE_API_KEY
# only in your shell profile will work in an interactive `./pulse.sh`
# but silently break the scheduled run -- the model will be unable to
# search and the expand stage will produce an empty brief, just like a
# context overflow. Put the key HERE (in .env, which pulse.sh sources
# explicitly via `set -a; source .env; set +a`) so both invocation
# paths see it. The launchd plist itself does NOT need to declare it.
# BRAVE_API_KEY="brv-..."

# Pi provider + model. Defaults work if you have kimi-k2.6:cloud
# configured under an `ollama` provider in ~/.pi/agent/models.json.
# PI_PROVIDER=ollama
# PI_MODEL=kimi-k2.6:cloud

# History windows (days). Defaults: 30 notes, 7 sesh.
# PI_PULSE_NOTES_SINCE=30
# PI_PULSE_SESH_SINCE=7

# Card quotas. The plan stage picks exactly this many of each type
# from the memo, and the expand stage writes one card per planned
# topic. Defaults: 5 tracked + 2 adjacent + 1 bridge = 8 cards.
#
# - tracked  = topics from the memo's Active / Persistent sections
# - adjacent = topics matching the durable profile but not in the memo
# - bridge   = topics from the memo's Study reinforcement section
#              connected to a current paper, post, or release
#
# Set bridge=0 if you don't use Anki or don't want the leech-bridge
# card.
# PI_PULSE_CARDS_TRACKED=5
# PI_PULSE_CARDS_ADJACENT=2
# PI_PULSE_CARDS_BRIDGE=1
