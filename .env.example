# Copy to .env (gitignored) and edit. `pulse.sh` auto-sources .env.

# Directory tree of YYYY/MM/DD/*.md notes (e.g. an Obsidian vault that
# stores exported LLM chats). Required.
PI_PULSE_NOTES_DIR="$HOME/notes/chats"

# Where to drop the daily brief in addition to ./out/. Optional. If
# unset, the brief is only written to ./out/YYYY-MM-DD.md.
PI_PULSE_DELIVERY="$HOME/notes/Pulse"

# Path to the anki_search.py script from the anki-search skill.
# Optional; if unset, the collector looks at the default location
# ~/.claude/skills/anki-search/anki_search.py and on $PATH.
# PI_PULSE_ANKI_SEARCH="$HOME/.claude/skills/anki-search/anki_search.py"

# Pi provider + model. Defaults work if you have kimi-k2.6:cloud
# configured under an `ollama` provider in ~/.pi/agent/models.json.
# PI_PROVIDER=ollama
# PI_MODEL=kimi-k2.6:cloud

# History windows (days). Defaults: 30 notes, 7 sesh.
# PI_PULSE_NOTES_SINCE=30
# PI_PULSE_SESH_SINCE=7
