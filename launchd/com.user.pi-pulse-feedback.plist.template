<?xml version="1.0" encoding="UTF-8"?>
<!--
  Pi Pulse feedback-server LaunchAgent.

  Install with scripts/install-feedback-server.sh rather than rendering this
  template by hand. The installer creates a native app wrapper under
  ~/Applications, obtains its Documents-folder consent, and substitutes:

    {{REPO}}      Absolute path to the pi-pulse checkout
    {{HOME}}      User home directory
    {{APP_EXEC}}  Native executable inside Pi Pulse Feedback.app
    {{PATH}}      PATH containing the Tailscale CLI

  The native app is the stable TCC identity responsible for protected-folder
  access. Do not point this job directly at bash or Python: a cold launch after
  reboot would then lack access to a checkout under ~/Documents.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.pi-pulse-feedback</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{APP_EXEC}}</string>
        <string>--serve</string>
        <string>--repo</string>
        <string>{{REPO}}</string>
    </array>

    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.user.pi-pulse-feedback</string>
    </array>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <!-- Keep launchd's own file operations outside TCC-protected Documents. -->
    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/pi-pulse/feedback-server.out.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/pi-pulse/feedback-server.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{PATH}}</string>
        <key>HOME</key>
        <string>{{HOME}}</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
