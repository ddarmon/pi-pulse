<?xml version="1.0" encoding="UTF-8"?>
<!--
  Scheduled pi-pulse LaunchAgent.

  Install with scripts/install-pulse-agent.sh rather than rendering this
  template by hand. The installer compiles a native app wrapper under
  ~/Applications ("Pi Pulse.app"), obtains its Documents-folder consent
  once, and substitutes:

    {{REPO}}      Absolute path to the pi-pulse checkout
    {{HOME}}      User home directory
    {{APP_EXEC}}  Native executable inside Pi Pulse.app
    {{PATH}}      PATH containing pi, uv, sesh, ollama, node, and curl
    {{HOUR}}      Daily run hour (default 5)
    {{MINUTE}}    Daily run minute (default 0)

  The native app is the stable TCC identity responsible for
  protected-folder access. Do not point this job directly at bash: on a
  cold start, children such as node are denied access to a checkout under
  ~/Documents without any prompt, the expand guard fetch fails with EPERM,
  and the run aborts at the egress audit.

  Secrets (BRAVE_API_KEY, etc.) belong in {{REPO}}/.env, which the guard
  and pulse.sh read directly. launchd does NOT inherit your shell profile
  (~/.zprofile, ~/.zshrc), so keys exported only there will be missing at
  run time. Do not duplicate secrets into the EnvironmentVariables block
  below.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.pi-pulse</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{APP_EXEC}}</string>
        <string>--run</string>
        <string>--repo</string>
        <string>{{REPO}}</string>
    </array>

    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.user.pi-pulse</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>{{HOUR}}</integer>
        <key>Minute</key><integer>{{MINUTE}}</integer>
    </dict>

    <!-- Keep launchd's own file operations outside TCC-protected
         Documents; per-run logs still land in {{REPO}}/logs/. -->
    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/pi-pulse/pulse.out.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/pi-pulse/pulse.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>{{PATH}}</string>
        <key>HOME</key>
        <string>{{HOME}}</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
